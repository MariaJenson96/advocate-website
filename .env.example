# ---------------------------------------------------------------
# PUBLIC settings (VITE_ prefix = included in the website build)
# ---------------------------------------------------------------
# Public site URL (canonical URLs, Open Graph, sitemap.xml, robots.txt)
VITE_SITE_URL=https://www.example.com

# Where the appointment form sends enquiries.
# Use /api/enquiry for the built-in server function (recommended).
# Leave empty during design review — the form then simulates success in dev only.
VITE_ENQUIRY_ENDPOINT=/api/enquiry

# ---------------------------------------------------------------
# SERVER-ONLY settings (no VITE_ prefix — never sent to browsers)
# Used by api/enquiry.ts to email enquiries to the advocate.
# ---------------------------------------------------------------
# Gmail / Google Workspace: smtp.gmail.com, port 465, and an App Password
# Zoho Mail (India):        smtp.zoho.in,   port 465
# Outlook / Microsoft 365:  smtp.office365.com, port 587
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Inbox that receives enquiries (defaults to SMTP_USER)
ENQUIRY_TO=
# Optional: only accept submissions from these origins (comma-separated)
ALLOWED_ORIGINS=
